package com.example.meepmeeptesting;

import com.acmerobotics.roadrunner.geometry.Pose2d;
import com.acmerobotics.roadrunner.trajectory.Trajectory;
import com.noahbres.meepmeep.MeepMeep;
import com.noahbres.meepmeep.roadrunner.DefaultBotBuilder;
import com.noahbres.meepmeep.roadrunner.entity.RoadRunnerBotEntity;

public class MeepMeepTesting {
    public static void main(String[] args) {
        MeepMeep meepMeep = new MeepMeep(800);
        Pose2d startPose = new Pose2d(-35, 64, Math.toRadians(270));

        RoadRunnerBotEntity myBot = new DefaultBotBuilder(meepMeep)
                // Set bot constraints: maxVel, maxAccel, maxAngVel, maxAngAccel, track width
                .setConstraints(55.63236990731925, 55.63236990731925, Math.toRadians(318.74999999999994), Math.toRadians(318.74999999999994), 10)
                .setDimensions(15,15)
                .followTrajectorySequence(drive ->
                        drive.trajectorySequenceBuilder(startPose)
                                .forward(16.5)
                                .waitSeconds(1)

                                //Capping first preloaded cone
                                .lineToLinearHeading(new Pose2d(-35, 8, Math.toRadians(330))) //Better
                                //.splineToSplineHeading(new Pose2d(-8, 32, Math.toRadians(330)), Math.toRadians(0))
                                .waitSeconds(1)

                                //restock cone
                                .lineToLinearHeading(new Pose2d(-56, 10, Math.toRadians(175))) //It might roll over ground receptacle, if so, spline is better even if very weird
                                //.splineToSplineHeading(new Pose2d(-56, 10, Math.toRadians(175)), Math.toRadians(250))
                                .waitSeconds(1)

                                //place new cone
                                .lineToLinearHeading(new Pose2d(-35, 8, Math.toRadians(330))) //Same as above
                                //.splineToSplineHeading(new Pose2d(-35, 8, Math.toRadians(330)), Math.toRadians(250))
                                .waitSeconds(1)

                                //repeat 2 above steps if time

                                    //Park
                                //Position 1
                                .lineToLinearHeading(new Pose2d(-57, 11, Math.toRadians(180)))
                                //.splineToSplineHeading(new Pose2d(-57, 11, Math.toRadians(180)), Math.toRadians(250))

                                //Position 2
                                .lineToLinearHeading(new Pose2d(-35, 11, Math.toRadians(180)))
                                //.splineToSplineHeading(new Pose2d(-35, 11, Math.toRadians(180)), Math.toRadians(250)) //This spline is especially bad

                                //Position 3
                                .lineToLinearHeading(new Pose2d(-14, 11, Math.toRadians(180))) //Should just skirt the pole
                                //.splineToSplineHeading(new Pose2d(-14, 11, Math.toRadians(180)), Math.toRadians(270))
                                .build()
                );
        meepMeep.setBackground(MeepMeep.Background.FIELD_POWERPLAY_OFFICIAL)
                .setDarkMode(true)
                .setBackgroundAlpha(0.95f)
                .addEntity(myBot)
                .start();
    }
}
